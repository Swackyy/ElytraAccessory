{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modV}",
  "name": "${modName}",
  "description": "${modDesc}",
  "authors": [
    "${modAuthors}"
  ],
  "contact": {
    "homepage": "${gitUrl}",
    "sources": "${gitUrl}",
    "issues": "${gitUrl}/issues"
  },
  "license": "${license}",
  "icon": "${modId}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.swacky.${modId}.common.ElytraAccessoryMain"
    ],
    "client": [
      "com.swacky.${modId}.client.ElytraAccessoryClientMain"
    ],
    "fabric-datagen": [
      "com.swacky.${modId}.datagen.ElytraAccessoryDataGenerationMain"
    ]
  },
  "mixins": [
    "${modId}.mixins.json",
    "${modId}_common.mixins.json"
  ],
  "depends": {
    "fabricloader": "${loaderFabricVRange}",
    "minecraft": "~${mcVRangeMin}",
    "java": ">=${javaV}",
    "fabric-api": "*",
    "ohmega": "${loaderFabricOhmegaVRange}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.curseforge": "${curseUrl}",
        "modmenu.discord": "${discordUrl}",
        "modmenu.modrinth": "${modrinthUrl}"
      }
    },
    "update_checker": true
  }
}